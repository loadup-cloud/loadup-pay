# Required ordinary settings. Fill every empty value before creating snapshots.
PRODUCT_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_product
PRODUCT_JDBC_USERNAME=admin
PRODUCT_JWT_ISSUER_URI=https://identity.example.com
PRODUCT_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
PRODUCT_JWT_AUDIENCE=product
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false

# Kubernetes Service DNS defaults.
CUSTOMER_BASE_URL=http://customer:8080
LIMITCENTER_BASE_URL=http://limitcenter:8080

loadup.security.resource-server.enable=false