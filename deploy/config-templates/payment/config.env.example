# Required ordinary settings. Fill every empty value before creating snapshots.
PAYMENT_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_payment
PAYMENT_JDBC_USERNAME=admin
PAYMENT_JWT_ISSUER_URI=https://identity.example.com
PAYMENT_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
PAYMENT_JWT_AUDIENCE=payment
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false

# Kubernetes Service DNS defaults.
ACQUIRE_BASE_URL=http://acquire:8080
LIMITCENTER_BASE_URL=http://limitcenter:8080
REALTIME_BASE_URL=http://realtime:8080

loadup.security.resource-server.enable=false