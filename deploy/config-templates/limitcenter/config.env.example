# Required ordinary settings. Fill every empty value before creating snapshots.
LIMITCENTER_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_limitcenter
LIMITCENTER_JDBC_USERNAME=admin
LIMITCENTER_JWT_ISSUER_URI=https://identity.example.com
LIMITCENTER_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
LIMITCENTER_JWT_AUDIENCE=limitcenter
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false

loadup.security.resource-server.enable=false
# Kubernetes Service DNS defaults.
PAYMENT_BASE_URL=http://payment:8080
