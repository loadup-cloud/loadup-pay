# Required ordinary settings. Fill every empty value before creating snapshots.
ACQUIRE_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_acquire
ACQUIRE_JDBC_USERNAME=admin
ACQUIRE_JWT_ISSUER_URI=https://identity.example.com
ACQUIRE_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
ACQUIRE_JWT_AUDIENCE=acquire
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false

loadup.security.resource-server.enable=false
# Kubernetes Service DNS defaults.
PRODUCT_BASE_URL=http://product:8080
PAYMENT_BASE_URL=http://payment:8080
REALTIME_BASE_URL=http://realtime:8080
