# Required ordinary settings. Fill every empty value before creating snapshots.
CUSTOMER_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_customer
CUSTOMER_JDBC_USERNAME=admin
CUSTOMER_JWT_ISSUER_URI=https://identity.example.com
CUSTOMER_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
CUSTOMER_JWT_AUDIENCE=customer
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false
loadup.security.resource-server.enable=false