# Required ordinary settings. Fill every empty value before creating snapshots.
REALTIME_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_realtime
REALTIME_JDBC_USERNAME=admin
REALTIME_JWT_ISSUER_URI=https://identity.example.com
REALTIME_JWT_JWK_SET_URI=https://identity.example.com/oauth2/jwks

# Existing application defaults; adjust only for your environment.
REALTIME_JWT_AUDIENCE=realtime
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false

loadup.security.resource-server.enable=false