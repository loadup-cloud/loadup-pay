# Literal environment values; shared by all applications.
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false
LOADUP_SECURITY_RESOURCE_SERVER_ENABLED=true
# Supply the environment issuer and either a JWK Set URI or a mounted RSA public key.
JWT_ISSUER_URI=
JWT_PUBLIC_KEY_LOCATION=
JWT_JWK_SET_URI=
