# Required ordinary settings. Fill every empty value before creating snapshots.
RECONCILIATION_JDBC_URL=
RECONCILIATION_JDBC_USERNAME=

# Required private bucket; the application does not create it.
RECONCILIATION_S3_BUCKET=
RECONCILIATION_S3_REGION=us-east-1
RECONCILIATION_S3_PATH_STYLE=false
# RECONCILIATION_S3_ENDPOINT=
# Account catalog stays empty until explicitly configured; see reconciliation/README.md.

# Fixed deployment identity; override for each customer deployment.
DEPLOYMENT_CODE=local
# Single business schema owned by this application deployment.
DEPLOYMENT_DATABASE_SCHEMA=loadup_reconciliation
