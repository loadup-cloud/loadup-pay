# Dedicated control-plane database; do not route this connection by business tenant.
AUTHSERVER_JDBC_URL=
AUTHSERVER_JDBC_USERNAME=
AUTHSERVER_SIGNING_KEY=auth-jwt
OAUTH_MANAGEMENT_ISSUER_URI=http://admin:8080
OAUTH_MANAGEMENT_AUDIENCE=admin
OAUTH_MANAGEMENT_JWK_SET_URI=http://admin:8080/oauth2/jwks

# Fixed deployment identity; override for each customer deployment.
DEPLOYMENT_CODE=local
# Single business schema owned by this application deployment.
DEPLOYMENT_DATABASE_SCHEMA=loadup_oauth2
