# Required ordinary settings. Fill every empty value before creating snapshots.
RECONCILIATION_JDBC_URL=jdbc:postgresql://postgres.orb.local:5432/loadup_reconciliation
RECONCILIATION_JDBC_USERNAME=admin

# Existing application defaults; adjust only for your environment.
RECONCILIATION_JWT_AUDIENCE=reconciliation

# Kubernetes Service DNS defaults.
PAYMENT_BASE_URL=http://payment:8080

# Required private bucket; the application does not create it.
RECONCILIATION_S3_BUCKET=loadup-pay-reconciliation-local
RECONCILIATION_S3_REGION=us-east-1
RECONCILIATION_S3_PATH_STYLE=true
# RECONCILIATION_S3_ENDPOINT=
# Account catalog stays empty until explicitly configured; see reconciliation/README.md.

RECONCILIATION_S3_ENDPOINT=http://rustfs.orb.local:9000
