# Literal environment values; shared by all applications.
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false
LOADUP_SECURITY_RESOURCE_SERVER_ENABLED=true
# Retained issuer identifier for existing tokens; public-key verification makes no HTTP request.
JWT_ISSUER_URI=http://loadup-local-jwks.loadup-pay.svc.cluster.local:8080
JWT_PUBLIC_KEY_LOCATION=file:/var/run/loadup/secrets/jwt-public.pem
JWT_JWK_SET_URI=
