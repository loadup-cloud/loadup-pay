# Literal environment values; shared by all applications.
METRICS_ENABLED=true
SPRING_THREADS_VIRTUAL_ENABLED=false
LOADUP_SECURITY_RESOURCE_SERVER_ENABLED=true
JWT_ISSUER_URI=http://authserver.loadup-pay.svc.cluster.local:8080
JWT_JWK_SET_URI=http://authserver.loadup-pay.svc.cluster.local:8080/oauth2/jwks

# Token acquisition is separate from the stable issuer identifier. Use TLS outside local development.
SERVICE_AUTH_TOKEN_URI=http://authserver:8080/oauth2/token
SERVICE_AUTH_ALLOW_INSECURE_HTTP=true

# Nine local services share one PostgreSQL instance; keep capacity for rolling replacements.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
