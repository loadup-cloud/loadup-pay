<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>io.github.loadup-cloud</groupId>
    <artifactId>loadup-pay</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LoadUp Pay</name>
    <description>External acquiring applications and COLA client and domain contracts.</description>
    <url>https://github.com/loadup-cloud</url>
    <inceptionYear>2025</inceptionYear>
    <organization>
        <name>loadup_cloud</name>
    </organization>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Laysan</id>
            <email>lslvxy@gmail.com</email>
        </developer>
    </developers>

    <modules>
        <module>loadup-pay-bom</module>
        <module>loadup-pay-contracts</module>
        <module>loadup-pay-oauth2-server</module>
        <module>loadup-pay-admin</module>
        <module>loadup-pay-merchantcenter</module>
        <module>loadup-pay-limitcenter</module>
        <module>loadup-pay-productcenter</module>
        <module>loadup-pay-payment</module>
        <module>loadup-pay-acquire</module>
        <module>loadup-pay-realtime</module>
        <module>loadup-pay-reconciliation</module>
        <module>loadup-pay-notificationcenter</module>
    </modules>
    <properties>
        <java.version>25</java.version>
        <project.encoding>UTF-8</project.encoding>
        <project.build.encoding>${project.encoding}</project.build.encoding>
        <project.build.sourceEncoding>${project.encoding}</project.build.sourceEncoding>
        <project.reporting.outputEncoding>${project.encoding}</project.reporting.outputEncoding>
        <maven.compiler.encoding>${project.encoding}</maven.compiler.encoding>
        <maven.resources.encoding>${project.encoding}</maven.resources.encoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <loadup.testify.version>0.0.1-SNAPSHOT</loadup.testify.version>

        <!-- Manual quality and maintenance tools, aligned with LoadUp Framework. -->
        <license.useJavaNoReformatCommentStartTag>false</license.useJavaNoReformatCommentStartTag>
        <license.trimHeaderLine>true</license.trimHeaderLine>

        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <versions-plugin.version>2.23.0</versions-plugin.version>

        <spotless-plugin.version>3.11.0</spotless-plugin.version>

        <enforcer-plugin.version>3.6.3</enforcer-plugin.version>

        <palantir-java-format.version>2.98.0</palantir-java-format.version>

        <spotless.skip>false</spotless.skip>

        <enforcer.skip>false</enforcer.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.loadup-cloud</groupId>
                <artifactId>loadup-pay-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.loadup-cloud</groupId>
                <artifactId>loadup-testify-bom</artifactId>
                <version>${loadup.testify.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <!-- No executions: invoke these plugin goals explicitly. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                        <path>
                            <groupId>io.github.loadup-cloud</groupId>
                            <artifactId>loadup-components-database-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                    <annotationProcessors>
                        <annotationProcessor>org.mapstruct.ap.MappingProcessor</annotationProcessor>
                        <annotationProcessor>org.springframework.boot.configurationprocessor.ConfigurationMetadataAnnotationProcessor</annotationProcessor>
                        <annotationProcessor>io.github.loadup.components.database.processor.LoadUpMyBatisFlexProcessor</annotationProcessor>
                    </annotationProcessors>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-plugin.version}</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <configuration>
                    <!-- Framework-owned APT output only; handwritten code remains in scope. -->
                    <excludes>
                        <exclude>**/dataobject/table/**</exclude>
                        <exclude>**/mapper/*DOMapper.class</exclude>
                        <exclude>**/converter/*ConverterImpl.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-plugin.version}</version>
                <configuration>
                    <skip>${spotless.skip}</skip>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <licenseHeader>
                            <content><![CDATA[/*
                                 * Copyright (C) $YEAR LoadUp Cloud
                                 *
                                 * Licensed under the Apache License, Version 2.0 (the "License");
                                 * you may not use this file except in compliance with the License.
                                 * You may obtain a copy of the License at
                                 *
                                 *      http://www.apache.org/licenses/LICENSE-2.0
                                 *
                                 * Unless required by applicable law or agreed to in writing, software
                                 * distributed under the License is distributed on an "AS IS" BASIS,
                                 * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
                                 * See the License for the specific language governing permissions and
                                 * limitations under the License.
                                 */]]></content>
                        </licenseHeader>
                        <shortenFullyQualifiedTypes/>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <forbidWildcardImports/>
                        <forbidModuleImports/>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <formatAnnotations/>
                    </java>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                        </includes>
                        <sortPom>
                            <encoding>UTF-8</encoding>
                            <expandEmptyElements>false</expandEmptyElements>
                            <keepBlankLines>true</keepBlankLines>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                        </sortPom>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </pom>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <configuration>
                    <skip>${enforcer.skip}</skip>
                    <fail>true</fail>
                    <rules>
                        <bannedDependencies>
                            <searchTransitive>true</searchTransitive>
                            <excludes>
                                <exclude>commons-lang:commons-lang</exclude>
                                <exclude>cn.hutool</exclude>
                                <exclude>com.alibaba:fastjson:[,2.0.0)</exclude>
                                <exclude>log4j:log4j</exclude>
                                <exclude>junit:junit</exclude>
                                <exclude>org.slf4j:slf4j-log4j12</exclude>
                                <exclude>commons-collections:commons-collections:[,3.2.2)</exclude>
                            </excludes>
                        </bannedDependencies>
                    </rules>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Ensure containers are properly cleaned up -->
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
